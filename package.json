{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "artifacts/api-server",
    "artifacts/rgg-website",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "build": "npm run typecheck:hostinger && npm run build --workspace=@workspace/api-server && PORT=4173 BASE_PATH=/ npm run build --workspace=@workspace/rgg-website",
    "build:all": "npm run build && PORT=4174 BASE_PATH=/__mockup pnpm --filter @workspace/mockup-sandbox run build",
    "start": "NODE_ENV=production node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "test": "npm test --workspace=@workspace/api-server && npm test --workspace=@workspace/rgg-website",
    "test:production-routes": "node scripts/production-route-smoke.test.mjs",
    "migration:check": "npm run migration:check --workspace=@workspace/db",
    "migration:rebuild-check": "npm run migration:rebuild-check --workspace=@workspace/db",
    "migration:baseline": "npm run test:migration-baseline --workspace=@workspace/scripts",
    "audit:env": "node scripts/hostinger-env-audit.mjs",
    "report:assets": "node scripts/hostinger-static-inventory.mjs artifacts/rgg-website/dist/public",
    "test:api-targeted-typecheck": "bash scripts/api-targeted-typecheck.test.sh",
    "typecheck:libs": "tsc --build",
    "typecheck:hostinger": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "typecheck": "npm run typecheck:hostinger && pnpm --filter @workspace/mockup-sandbox --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.8.3"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.7",
    "esbuild": "0.27.3",
    "fast-uri": "3.1.6",
    "linkify-it": "5.0.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.28"
  }
}
